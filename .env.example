# ============================================================
# HRANALYST PLACEMENT WING
# ENVIRONMENT TEMPLATE
# ============================================================

NODE_ENV=production

NEXT_PUBLIC_APP_NAME=HRAnalyst Placement Wing
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_URL=https://placements.example.com


# ------------------------------------------------------------
# SUPABASE
# ------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# ------------------------------------------------------------
# OPENAI
# ------------------------------------------------------------

OPENAI_API_KEY=
OPENAI_CHECKLIST_MODEL=
OPENAI_CV_MODEL=

# Existing HRAnalyst student registry (required to provision Students)
HRANALYST_STUDENT_VERIFY_URL=
HRANALYST_STUDENT_VERIFY_TOKEN=


# ------------------------------------------------------------
# SMTP
# ------------------------------------------------------------

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=HRAnalyst Placement Wing

EMAIL_ENABLED=true


# ------------------------------------------------------------
# CRON / WORKER SECURITY
# ------------------------------------------------------------

CRON_SECRET=

NOTIFICATION_BATCH_SIZE=50


# ------------------------------------------------------------
# WHATSAPP
# ------------------------------------------------------------

WHATSAPP_ENABLED=false
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=


# ------------------------------------------------------------
# TELEGRAM
# ------------------------------------------------------------

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_JOB_CHANNEL_ID=


# ------------------------------------------------------------
# PERFORMANCE TESTING
# MUST REMAIN FALSE IN NORMAL PRODUCTION
# ------------------------------------------------------------

PERF_TEST_ENABLED=false
ALLOW_PRODUCTION_PERF_TEST=false
PERF_TEST_SECRET=
PERF_TEST_BASE_URL=http://localhost:3000
PERF_TEST_USER_PASSWORD=
PERF_STUDENT_COUNT=1000
PERF_JOB_COUNT=100
PERF_APPLICATION_COUNT=1000
PERF_NOTIFICATION_COUNT=1000
PERF_CONCURRENCY=50
PERF_DURATION_SECONDS=30
PERF_FEED_P95_MS=2000
PERF_FEED_P99_MS=3000
PERF_ERROR_RATE_PERCENT=1

# UAT, release, and bootstrap scripts
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
UAT_USER_PASSWORD=
PRODUCTION_BASE_URL=
SMTP_TEST_RECIPIENT=

# Set true only during a planned maintenance window.
MAINTENANCE_MODE=false

# Browser E2E accounts (seeded test environment only)
E2E_BASE_URL=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_PLACEMENT_HR_EMAIL=
E2E_PLACEMENT_HR_PASSWORD=
E2E_CLIENT_HR_EMAIL=
E2E_CLIENT_HR_PASSWORD=
E2E_STUDENT_EMAIL=
E2E_STUDENT_PASSWORD=


# ------------------------------------------------------------
# OBSERVABILITY
# ------------------------------------------------------------

LOG_LEVEL=info
